{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:55888",
      "sslPort": 44380
    }
  },
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5229",
        "environmentVariables": {
            "ASPNETCORE_ENVIRONMENT": "Development",
            "DatabaseConnectionString": "",
            "CosmosAccountEndpoint": "",
            "CosmosAuthKey": "",
            "CosmosDatabaseName": "",
            "CosmosContainerName": ""
        }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7280;http://localhost:5229",
        "environmentVariables": {
            "ASPNETCORE_ENVIRONMENT": "Development",
            "DatabaseConnectionString": "",
            "CosmosAccountEndpoint": "",
            "CosmosAuthKey": "",
            "CosmosDatabaseName": "",
            "CosmosContainerName": ""
        }
    },
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
